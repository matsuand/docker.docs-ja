command: docker pass get
short: Get a secret from a keystore.
long: |-
    Retrieves a named secret from the local OS keychain. The secret value is masked in output.
usage: docker pass get NAME
pname: docker pass
plink: docker_pass.yaml
deprecated: false
hidden: false
experimental: false
experimentalcli: false
kubernetes: false
swarm: false
