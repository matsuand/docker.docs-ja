%This is the change file for the original Docker's Documentation file.
%This is part of Japanese translation version for Docker's Documantation.

@x
name: sbx daemon log-level set
synopsis: 'Set a category''s log level (target: proxy, general, or all)'
usage: sbx daemon log-level set <target> <level> [flags]
options:
    - name: help
      shorthand: h
      default_value: "false"
      usage: help for set
inherited_options:
    - name: debug
      shorthand: D
      default_value: "false"
      usage: Enable debug logging
see_also:
    - sbx daemon log-level - Inspect or change sandboxd's per-category log levels
@y
name: sbx daemon log-level set
synopsis: 'Set a category''s log level (target: proxy, general, or all)'
usage: sbx daemon log-level set <target> <level> [flags]
options:
    - name: help
      shorthand: h
      default_value: "false"
      usage: help for set
inherited_options:
    - name: debug
      shorthand: D
      default_value: "false"
      usage: Enable debug logging
see_also:
    - sbx daemon log-level - Inspect or change sandboxd's per-category log levels
@z
