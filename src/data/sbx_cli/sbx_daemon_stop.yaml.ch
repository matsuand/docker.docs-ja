@x
name: sbx daemon stop
synopsis: Stop the sandboxd daemon
usage: sbx daemon stop [flags]
options:
    - name: help
      shorthand: h
      default_value: "false"
      usage: help for stop
inherited_options:
    - name: debug
      shorthand: D
      default_value: "false"
      usage: Enable debug logging
see_also:
    - sbx daemon - Manage sandboxd daemon
