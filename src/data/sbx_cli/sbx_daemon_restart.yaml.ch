@x
name: sbx daemon restart
synopsis: Restart the sandboxd daemon
usage: sbx daemon restart [flags]
options:
    - name: help
      shorthand: h
      default_value: "false"
      usage: help for restart
inherited_options:
    - name: debug
      shorthand: D
      default_value: "false"
      usage: Enable debug logging
see_also:
    - sbx daemon - Manage sandboxd daemon
