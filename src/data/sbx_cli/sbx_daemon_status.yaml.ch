@x
name: sbx daemon status
synopsis: Check sandboxd daemon status
usage: sbx daemon status [flags]
options:
    - name: help
      shorthand: h
      default_value: "false"
      usage: help for status
    - name: json
      default_value: "false"
      usage: Output as JSON
inherited_options:
    - name: debug
      shorthand: D
      default_value: "false"
      usage: Enable debug logging
see_also:
    - sbx daemon - Manage sandboxd daemon
